.env
.venv/
runs/

# Zhihu login cookies (never commit)
configs/zhihu.cookies.json
**/zhihu.cookies.json
!configs/zhihu.cookies.example.json
.cursor/*
!.cursor/permissions.json
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/README.md

# Claude 本地配置忽略，但 skills 纳入版本库
.claude/*
!.claude/skills/
!.claude/skills/**
__pycache__/

# 个人 IDE 配置（无团队共享 settings 时不纳入版本库）
.vscode/
