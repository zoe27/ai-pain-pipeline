# Reddit OAuth — required for helpers/fetch_reddit.py
# Create a "script" app: https://www.reddit.com/prefs/apps
# (under the app name: string under icon = CLIENT_ID; secret = CLIENT_SECRET)

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=pain-radar/0.1 by /u/YOUR_REDDIT_USERNAME
