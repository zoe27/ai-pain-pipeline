# Copy to .env and fill in tokens for optional sources.
# Hacker News (Algolia) needs no credentials.
# Never commit .env — it is listed in .gitignore.

# --- Reddit (helpers/fetch_reddit.py) ---
# Create a "script" app: https://www.reddit.com/prefs/apps
# Reddit Data API access must be approved for production use.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=pain-radar/0.1 by /u/YOUR_REDDIT_USERNAME

# --- GitHub Issues (helpers/fetch_github_issues.py) ---
# Optional; raises rate limits. Public repos work without token.
GITHUB_TOKEN=

# --- Product Hunt (helpers/fetch_producthunt.py) ---
# https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=
