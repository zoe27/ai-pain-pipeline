{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "growth_metrics.schema.json",
  "title": "Growth & Operations Metrics",
  "description": "Stage 9 output: business metrics, growth metrics, and operational data",
  "type": "object",
  "required": [
    "pipeline_id",
    "deployment_id",
    "created_at",
    "product_title",
    "reporting_period",
    "product_metrics",
    "business_metrics",
    "acquisition_channels",
    "churn_analysis",
    "feature_adoption",
    "revenue_summary",
    "growth_recommendations"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1
    },
    "reporting_period": {
      "type": "object",
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "product_metrics": {
      "type": "object",
      "required": ["dau", "mau", "retention_day_1", "retention_day_7", "retention_day_30"],
      "properties": {
        "dau": { "type": "integer", "minimum": 0 },
        "wau": { "type": "integer", "minimum": 0 },
        "mau": { "type": "integer", "minimum": 0 },
        "avg_session_length_minutes": { "type": "number", "minimum": 0 },
        "sessions_per_user": { "type": "number", "minimum": 0 },
        "retention_day_1": { "type": "number", "minimum": 0, "maximum": 100 },
        "retention_day_7": { "type": "number", "minimum": 0, "maximum": 100 },
        "retention_day_30": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "business_metrics": {
      "type": "object",
      "properties": {
        "total_signups": { "type": "integer", "minimum": 0 },
        "new_signups_this_period": { "type": "integer", "minimum": 0 },
        "conversion_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "arr_usd": { "type": "number", "minimum": 0 },
        "mrr_usd": { "type": "number", "minimum": 0 },
        "average_revenue_per_user_usd": { "type": "number", "minimum": 0 },
        "customer_lifetime_value_usd": { "type": "number", "minimum": 0 },
        "customer_acquisition_cost_usd": { "type": "number", "minimum": 0 },
        "payback_period_months": { "type": "number", "minimum": 0 }
      }
    },
    "acquisition_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["channel", "signups", "cost_usd"],
        "properties": {
          "channel": { "type": "string", "enum": ["organic", "paid_search", "paid_social", "referral", "partnership", "pr", "viral", "other"] },
          "signups": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "cac_usd": { "type": "number", "minimum": 0 },
          "roas": { "type": "number", "minimum": 0 },
          "trending": { "type": "string", "enum": ["up", "flat", "down"] }
        },
        "additionalProperties": false
      }
    },
    "churn_analysis": {
      "type": "object",
      "required": ["monthly_churn_rate", "reasons"],
      "properties": {
        "monthly_churn_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "churned_users": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "percentage"],
            "properties": {
              "reason": { "type": "string" },
              "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
              "mitigation": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "retention_improvement_plan": { "type": "string", "minLength": 30 }
      },
      "additionalProperties": false
    },
    "feature_adoption": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature_name", "adoption_rate"],
        "properties": {
          "feature_name": { "type": "string" },
          "adoption_rate": { "type": "number", "minimum": 0, "maximum": 100 },
          "usage_frequency": { "type": "string" },
          "user_feedback_score": { "type": "number", "minimum": 1, "maximum": 5 },
          "trend": { "type": "string", "enum": ["trending_up", "stable", "declining"] }
        },
        "additionalProperties": false
      }
    },
    "revenue_summary": {
      "type": "object",
      "required": ["total_revenue", "revenue_by_plan"],
      "properties": {
        "total_revenue": { "type": "number", "minimum": 0 },
        "revenue_by_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plan_name": { "type": "string" },
              "subscribers": { "type": "integer", "minimum": 0 },
              "revenue_usd": { "type": "number", "minimum": 0 },
              "mrr_usd": { "type": "number", "minimum": 0 }
            }
          }
        },
        "refunds_chargebacks": { "type": "number", "minimum": 0 },
        "payment_success_rate": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "growth_recommendations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["opportunity", "potential_impact", "effort", "priority"],
        "properties": {
          "opportunity": { "type": "string", "minLength": 30 },
          "potential_impact": { "type": "string", "enum": ["high", "medium", "low"] },
          "effort": { "type": "string", "enum": ["high", "medium", "low"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
          "implementation_notes": { "type": "string" },
          "expected_lift": { "type": "string", "description": "e.g., '15% increase in MAU'" }
        },
        "additionalProperties": false
      }
    },
    "comparison_to_plan": {
      "type": "object",
      "properties": {
        "mau_target": { "type": "integer", "minimum": 0 },
        "mau_vs_target": { "type": "string", "enum": ["on_track", "ahead", "behind"] },
        "arr_target": { "type": "number", "minimum": 0 },
        "arr_vs_target": { "type": "string", "enum": ["on_track", "ahead", "behind"] },
        "key_variance_explanations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "next_quarter_plan": {
      "type": "object",
      "properties": {
        "focus_areas": { "type": "array", "items": { "type": "string" } },
        "feature_roadmap": { "type": "array", "items": { "type": "string" } },
        "growth_experiments": { "type": "array", "items": { "type": "string" } },
        "expansion_opportunities": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
