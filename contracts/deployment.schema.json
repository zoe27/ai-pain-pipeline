{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deployment.schema.json",
  "title": "Deployment Report",
  "description": "Stage 8 output: production deployment and monitoring setup",
  "type": "object",
  "required": [
    "pipeline_id",
    "code_delivery_id",
    "created_at",
    "product_title",
    "deployment_environment",
    "deployment_timestamp",
    "services_deployed",
    "monitoring_setup",
    "incident_response_plan",
    "success_criteria_met",
    "metrics_baseline"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "code_delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1
    },
    "deployment_environment": {
      "type": "object",
      "required": ["name", "url", "infrastructure_provider"],
      "properties": {
        "name": { "type": "string", "enum": ["staging", "production"] },
        "url": { "type": "string", "format": "uri" },
        "infrastructure_provider": { "type": "string" },
        "region": { "type": "string" },
        "instance_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deployment_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When deployment was executed"
    },
    "git_commit": {
      "type": "string",
      "minLength": 7,
      "description": "Commit hash deployed"
    },
    "services_deployed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "health_check_status"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "health_check_status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
          "uptime_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "error_rate": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "monitoring_setup": {
      "type": "object",
      "required": ["dashboards", "alerts"],
      "properties": {
        "dashboards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "key_metrics": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "threshold", "severity"],
            "properties": {
              "name": { "type": "string" },
              "metric": { "type": "string" },
              "threshold": { "type": "string" },
              "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
              "notification_channels": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "log_aggregation": { "type": "string", "enum": ["sentry", "datadog", "cloudwatch", "other"] },
        "apm_tool": { "type": "string", "enum": ["newrelic", "datadog", "elastic", "other"] }
      },
      "additionalProperties": false
    },
    "incident_response_plan": {
      "type": "object",
      "required": ["on_call_schedule", "escalation_process"],
      "properties": {
        "on_call_schedule": { "type": "string", "minLength": 20 },
        "escalation_process": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": { "type": "integer", "minimum": 1 },
              "contact": { "type": "string" },
              "response_time_minutes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "runbook_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      },
      "additionalProperties": false
    },
    "success_criteria_met": {
      "type": "object",
      "required": ["deployment_successful", "zero_downtime", "all_tests_passed"],
      "properties": {
        "deployment_successful": { "type": "boolean" },
        "zero_downtime": { "type": "boolean" },
        "all_tests_passed": { "type": "boolean" },
        "performance_baseline_met": { "type": "boolean" },
        "data_migration_successful": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "metrics_baseline": {
      "type": "object",
      "properties": {
        "api_latency_p95_ms": { "type": "number", "minimum": 0 },
        "api_error_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "database_connections_active": { "type": "integer", "minimum": 0 },
        "cache_hit_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpu_usage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_usage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "disk_usage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "rollback_plan": {
      "type": "object",
      "properties": {
        "can_rollback": { "type": "boolean" },
        "rollback_procedure": { "type": "string", "minLength": 30 },
        "estimated_rollback_time_minutes": { "type": "integer", "minimum": 1 },
        "data_consistency_check": { "type": "string", "minLength": 20 }
      }
    }
  }
}
