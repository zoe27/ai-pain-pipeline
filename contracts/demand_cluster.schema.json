{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "demand_cluster.schema.json",
  "title": "Demand Cluster",
  "description": "G2 output: clustered demands with demand score",
  "type": "object",
  "required": [
    "growth_id",
    "created_at",
    "clusters",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "growth_id": {
      "type": "string",
      "pattern": "^growth_(zhihu|reddit|hn|multi)_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "label",
          "question_ids",
          "demand_score"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Kebab-case identifier like pdf-to-excel"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "description": "Human-readable label"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "description": "What this cluster represents"
          },
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Zhihu question IDs in this cluster"
          },
          "question_count": {
            "type": "integer",
            "minimum": 1
          },
          "demand_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Overall demand strength (0-100)"
          },
          "score_breakdown": {
            "type": "object",
            "properties": {
              "volume_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Based on question count"
              },
              "engagement_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Based on views, answers, followers"
              },
              "intent_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Based on commercial intent"
              },
              "freshness_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Based on recent activity"
              }
            },
            "additionalProperties": false
          },
          "total_view_count": {
            "type": "integer",
            "minimum": 0
          },
          "avg_answer_count": {
            "type": "number",
            "minimum": 0
          },
          "avg_follower_count": {
            "type": "number",
            "minimum": 0
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Representative keywords for this cluster"
          },
          "trend": {
            "type": "string",
            "enum": ["up", "stable", "down", "unknown"],
            "description": "Demand trend direction"
          },
          "top_questions": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["question_id", "title", "url"],
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "view_count": {
                  "type": "integer"
                },
                "answer_count": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "description": "Top questions in this cluster"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["total_signals", "total_clusters"],
      "properties": {
        "total_signals": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of signals used for clustering"
        },
        "total_clusters": {
          "type": "integer",
          "minimum": 0
        },
        "clustering_method": {
          "type": "string",
          "description": "AI-based clustering"
        },
        "score_weights": {
          "type": "object",
          "properties": {
            "volume_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "engagement_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "intent_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "freshness_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false,
          "description": "Weights used for demand score calculation"
        }
      },
      "additionalProperties": false
    }
  }
}
