{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tech_spec.schema.json",
  "title": "Technical Specification",
  "description": "Stage 5 output: architecture design with tech stack and system design",
  "type": "object",
  "required": [
    "pipeline_id",
    "prd_id",
    "created_at",
    "product_title",
    "architecture_overview",
    "tech_stack",
    "system_design",
    "api_contracts",
    "database_schema",
    "deployment_architecture",
    "security_considerations",
    "scalability_plan",
    "development_phases"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "prd_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1
    },
    "architecture_overview": {
      "type": "object",
      "required": ["diagram_description", "key_components", "data_flow"],
      "properties": {
        "diagram_description": { "type": "string", "minLength": 50 },
        "key_components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "responsibility"],
            "properties": {
              "name": { "type": "string" },
              "responsibility": { "type": "string", "minLength": 20 }
            },
            "additionalProperties": false
          }
        },
        "data_flow": { "type": "string", "minLength": 50 }
      },
      "additionalProperties": false
    },
    "tech_stack": {
      "type": "object",
      "required": ["frontend", "backend", "database", "infrastructure"],
      "properties": {
        "frontend": {
          "type": "object",
          "properties": {
            "framework": { "type": "string" },
            "languages": { "type": "array", "items": { "type": "string" } },
            "key_libraries": { "type": "array", "items": { "type": "string" } }
          }
        },
        "backend": {
          "type": "object",
          "properties": {
            "framework": { "type": "string" },
            "language": { "type": "string" },
            "runtime": { "type": "string" },
            "key_libraries": { "type": "array", "items": { "type": "string" } }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "cache": { "type": "string" },
            "search": { "type": "string" }
          }
        },
        "infrastructure": {
          "type": "object",
          "properties": {
            "hosting": { "type": "string" },
            "container_orchestration": { "type": "string" },
            "monitoring": { "type": "array", "items": { "type": "string" } },
            "ci_cd": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "system_design": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["component", "description", "technologies"],
        "properties": {
          "component": { "type": "string" },
          "description": { "type": "string", "minLength": 30 },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "responsibilities": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "api_contracts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["endpoint", "method", "description"],
        "properties": {
          "endpoint": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
          "description": { "type": "string" },
          "request_schema": { "type": "object" },
          "response_schema": { "type": "object" },
          "authentication": { "type": "string" },
          "rate_limits": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "database_schema": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "columns", "primary_key"],
            "properties": {
              "name": { "type": "string" },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "nullable": { "type": "boolean" },
                    "default": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                }
              },
              "primary_key": { "type": "array", "items": { "type": "string" } },
              "indexes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "foreign_keys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": { "type": "string" },
                    "references": { "type": "string" }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "deployment_architecture": {
      "type": "object",
      "required": ["environments", "deployment_process"],
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "enum": ["development", "staging", "production"] },
              "scaling": { "type": "string" },
              "backup_strategy": { "type": "string" }
            }
          }
        },
        "deployment_process": { "type": "string", "minLength": 30 },
        "monitoring_alerts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "security_considerations": {
      "type": "object",
      "required": ["authentication", "data_protection", "compliance"],
      "properties": {
        "authentication": { "type": "string", "minLength": 20 },
        "authorization": { "type": "string", "minLength": 20 },
        "data_protection": { "type": "string", "minLength": 20 },
        "compliance": { "type": "array", "items": { "type": "string" } },
        "threat_mitigations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "scalability_plan": {
      "type": "object",
      "required": ["vertical_scaling", "horizontal_scaling"],
      "properties": {
        "expected_load": { "type": "string", "minLength": 20 },
        "vertical_scaling": { "type": "string", "minLength": 20 },
        "horizontal_scaling": { "type": "string", "minLength": 20 },
        "bottleneck_analysis": { "type": "string", "minLength": 20 },
        "performance_targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "development_phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["phase", "duration_weeks", "deliverables", "dependencies"],
        "properties": {
          "phase": { "type": "string" },
          "duration_weeks": { "type": "integer", "minimum": 1 },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "success_criteria": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "estimated_effort_hours": {
      "type": "integer",
      "minimum": 10
    }
  }
}
