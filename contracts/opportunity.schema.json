{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunity.schema.json",
  "title": "Opportunity",
  "description": "Stage 3 (User Research) output: validated opportunity package for one pain theme.",
  "type": "object",
  "required": [
    "pipeline_id",
    "researched_at",
    "input_file",
    "pain_point_id",
    "title",
    "one_liner",
    "target_personas",
    "existing_solutions",
    "market_size",
    "product_hypothesis",
    "recommendation",
    "confidence",
    "research_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "researched_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "pain_point_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary pain point this opportunity is anchored to"
    },
    "related_pain_point_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "description": "Additional stage-1 pain points merged into this research"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "target_personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/Persona" }
    },
    "existing_solutions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ExistingSolution" }
    },
    "market_size": {
      "type": "object",
      "required": ["tam_usd", "sam_usd", "som_usd"],
      "additionalProperties": false,
      "properties": {
        "tam_usd": { "type": "integer", "minimum": 0 },
        "sam_usd": { "type": "integer", "minimum": 0 },
        "som_usd": { "type": "integer", "minimum": 0 }
      }
    },
    "product_hypothesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 1000
    },
    "recommendation": {
      "type": "string",
      "enum": ["build", "skip", "partner"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "research_notes": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000
    }
  },
  "definitions": {
    "Persona": {
      "type": "object",
      "required": ["name", "pain_intensity", "willingness_to_pay", "persona_size_estimate", "quotes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pain_intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "willingness_to_pay": { "type": "integer", "minimum": 1, "maximum": 10 },
        "persona_size_estimate": { "type": "integer", "minimum": 0 },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "ExistingSolution": {
      "type": "object",
      "required": ["name", "pricing", "weaknesses"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pricing": { "type": "string", "minLength": 1 },
        "weaknesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      }
    }
  }
}
