{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunity.schema.json",
  "title": "Opportunity",
  "description": "Stage 3 (User Research) output: validated opportunity package for one pain theme.",
  "type": "object",
  "required": [
    "pipeline_id",
    "researched_at",
    "input_file",
    "pain_point_id",
    "title",
    "one_liner",
    "target_personas",
    "existing_solutions",
    "market_size",
    "product_hypothesis",
    "recommendation",
    "confidence",
    "research_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "researched_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "pain_point_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary pain point this opportunity is anchored to"
    },
    "related_pain_point_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "description": "Additional stage-1 pain points merged into this research"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "target_personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/Persona" }
    },
    "existing_solutions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ExistingSolution" }
    },
    "market_size": {
      "type": "object",
      "required": ["tam_usd", "sam_usd", "som_usd"],
      "additionalProperties": false,
      "properties": {
        "tam_usd": { "type": "integer", "minimum": 0 },
        "sam_usd": { "type": "integer", "minimum": 0 },
        "som_usd": { "type": "integer", "minimum": 0 }
      }
    },
    "product_hypothesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 1000
    },
    "recommendation": {
      "type": "string",
      "enum": ["build", "skip", "partner", "validate"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "research_notes": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000
    },
    "confidence_basis": {
      "$ref": "#/definitions/ConfidenceBasis"
    },
    "evidence_ledger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/definitions/EvidenceEntry" }
    },
    "unsupported_assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      }
    },
    "validation_required": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/ValidationItem" }
    }
  },
  "definitions": {
    "ConfidenceBasis": {
      "type": "object",
      "required": ["source_count", "product_count", "cross_run", "rationale"],
      "additionalProperties": false,
      "properties": {
        "source_count": { "type": "integer", "minimum": 1 },
        "product_count": { "type": "integer", "minimum": 1 },
        "cross_run": { "type": "boolean" },
        "switch_intent_present": { "type": "boolean" },
        "wtp_signal_present": { "type": "boolean" },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["claim", "evidence", "strength"],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/EvidenceItem" }
        },
        "strength": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "assumptions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["source", "quote", "pain_point_id"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["reddit", "hackernews", "github_issues", "producthunt", "app_store"]
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "pain_point_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidationItem": {
      "type": "object",
      "required": ["experiment", "success_criterion", "priority"],
      "additionalProperties": false,
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "success_criterion": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "Persona": {
      "type": "object",
      "required": ["name", "pain_intensity", "willingness_to_pay", "persona_size_estimate", "quotes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pain_intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "willingness_to_pay": { "type": "integer", "minimum": 1, "maximum": 10 },
        "persona_size_estimate": { "type": "integer", "minimum": 0 },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "ExistingSolution": {
      "type": "object",
      "required": ["name", "pricing", "weaknesses"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pricing": { "type": "string", "minLength": 1 },
        "weaknesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      }
    }
  }
}
