{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunity.schema.json",
  "title": "Opportunity",
  "description": "Stage 3 (User Research) output: validated opportunity package for one pain theme.",
  "type": "object",
  "required": [
    "pipeline_id",
    "researched_at",
    "input_file",
    "pain_point_id",
    "title",
    "one_liner",
    "target_personas",
    "existing_solutions",
    "market_size",
    "product_hypothesis",
    "recommendation",
    "confidence",
    "research_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "researched_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "pain_point_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary pain point this opportunity is anchored to"
    },
    "related_pain_point_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "description": "Additional stage-1 pain points merged into this research"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "target_personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/Persona" }
    },
    "existing_solutions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ExistingSolution" }
    },
    "market_size": {
      "type": "object",
      "required": ["tam_usd", "sam_usd", "som_usd"],
      "additionalProperties": false,
      "properties": {
        "tam_usd": { "type": "integer", "minimum": 0 },
        "sam_usd": { "type": "integer", "minimum": 0 },
        "som_usd": { "type": "integer", "minimum": 0 }
      }
    },
    "product_hypothesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 1000
    },
    "recommendation": {
      "type": "string",
      "enum": ["build", "skip", "partner", "validate"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "research_notes": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000
    },
    "confidence_basis": {
      "$ref": "#/definitions/ConfidenceBasis"
    },
    "evidence_ledger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/definitions/EvidenceEntry" }
    },
    "unsupported_assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      }
    },
    "validation_required": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/ValidationItem" }
    },
    "commercial_assessment": {
      "$ref": "#/definitions/CommercialAssessment"
    },
    "opportunity_score": {
      "$ref": "#/definitions/OpportunityScore"
    }
  },
  "definitions": {
    "CommercialAssessment": {
      "type": "object",
      "required": [
        "pain_score",
        "frequency_score",
        "switching_cost",
        "switching_willingness",
        "workaround_analysis",
        "buyer_mapping",
        "persistence",
        "economic_impact",
        "competition_score"
      ],
      "additionalProperties": false,
      "properties": {
        "pain_score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "frequency_score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "switching_willingness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = users actively seeking alternatives; 1 = locked in"
        },
        "switching_cost": { "$ref": "#/definitions/SwitchingCost" },
        "workaround_analysis": { "$ref": "#/definitions/WorkaroundAnalysis" },
        "buyer_mapping": { "$ref": "#/definitions/BuyerMapping" },
        "persistence": { "$ref": "#/definitions/PersistenceAnalysis" },
        "economic_impact": { "$ref": "#/definitions/EconomicImpact" },
        "competition_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = crowded market with strong incumbents"
        }
      }
    },
    "SwitchingCost": {
      "type": "object",
      "required": ["score", "rationale"],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = extremely hard to switch (Accounting, Email)"
        },
        "data_migration": { "type": "integer", "minimum": 1, "maximum": 10 },
        "learning_curve": { "type": "integer", "minimum": 1, "maximum": 10 },
        "team_collaboration": { "type": "integer", "minimum": 1, "maximum": 10 },
        "ecosystem_lock_in": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sunk_cost": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
      }
    },
    "WorkaroundAnalysis": {
      "type": "object",
      "required": [
        "current_workarounds",
        "quality_score",
        "cost_to_user",
        "satisfaction",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "current_workarounds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        },
        "quality_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = good enough workarounds already exist (bad for new product)"
        },
        "cost_to_user": { "type": "string", "enum": ["low", "medium", "high"] },
        "satisfaction": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
      }
    },
    "BuyerMapping": {
      "type": "object",
      "required": ["user", "beneficiary", "buyer", "champion", "buyer_exists_score"],
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 3, "maxLength": 120 },
        "beneficiary": { "type": "string", "minLength": 3, "maxLength": 120 },
        "buyer": { "type": "string", "minLength": 3, "maxLength": 120 },
        "champion": { "type": "string", "minLength": 3, "maxLength": 120 },
        "buyer_exists_score": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "PersistenceAnalysis": {
      "type": "object",
      "required": ["root_cause_type", "owner", "score", "rationale"],
      "additionalProperties": false,
      "properties": {
        "root_cause_type": {
          "type": "string",
          "enum": ["structural_permanent", "platform_bug", "regulatory", "unknown"]
        },
        "owner": {
          "type": "string",
          "enum": ["incumbent", "platform", "market", "none"]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = pain persists regardless of vendor fixes"
        },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
      }
    },
    "EconomicImpact": {
      "type": "object",
      "required": [
        "roi_score",
        "time_loss",
        "revenue_at_risk",
        "cashflow_impact",
        "quantification_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "roi_score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "time_loss": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "revenue_at_risk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "cashflow_impact": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "quantification_notes": { "type": "string", "minLength": 20, "maxLength": 500 }
      }
    },
    "OpportunityScore": {
      "type": "object",
      "required": ["total", "tier", "formula"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "tier": { "type": "string", "enum": ["high", "medium", "low", "watch"] },
        "formula": { "type": "string", "minLength": 20, "maxLength": 300 },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": { "type": "integer", "minimum": 0 },
            "denominator": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ConfidenceBasis": {
      "type": "object",
      "required": ["source_count", "product_count", "cross_run", "rationale"],
      "additionalProperties": false,
      "properties": {
        "source_count": { "type": "integer", "minimum": 1 },
        "product_count": { "type": "integer", "minimum": 1 },
        "cross_run": { "type": "boolean" },
        "switch_intent_present": { "type": "boolean" },
        "wtp_signal_present": { "type": "boolean" },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "EvidenceEntry": {
      "type": "object",
      "required": ["claim", "evidence", "strength"],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/EvidenceItem" }
        },
        "strength": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "assumptions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["source", "quote", "pain_point_id"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["reddit", "hackernews", "github_issues", "producthunt", "app_store"]
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "pain_point_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidationItem": {
      "type": "object",
      "required": ["experiment", "success_criterion", "priority"],
      "additionalProperties": false,
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "success_criterion": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "Persona": {
      "type": "object",
      "required": ["name", "pain_intensity", "willingness_to_pay", "persona_size_estimate", "quotes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pain_intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "willingness_to_pay": { "type": "integer", "minimum": 1, "maximum": 10 },
        "persona_size_estimate": { "type": "integer", "minimum": 0 },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "ExistingSolution": {
      "type": "object",
      "required": ["name", "pricing", "weaknesses"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pricing": { "type": "string", "minLength": 1 },
        "weaknesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      }
    }
  }
}
