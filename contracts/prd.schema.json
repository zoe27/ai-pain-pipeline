{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prd.schema.json",
  "title": "Product Requirements Document",
  "description": "Stage 4 output: comprehensive PRD with acceptance criteria and success metrics",
  "type": "object",
  "required": [
    "pipeline_id",
    "opportunity_id",
    "created_at",
    "product_title",
    "product_vision",
    "target_user_stories",
    "core_features",
    "acceptance_criteria",
    "success_metrics",
    "constraints_and_assumptions",
    "risks_and_mitigations",
    "competitive_positioning",
    "monetization_model"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "opportunity_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to Stage 3 opportunity"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "product_vision": {
      "type": "string",
      "minLength": 100,
      "maxLength": 1000,
      "description": "North star: what are we building and why"
    },
    "target_user_stories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["persona", "story", "acceptance"],
        "properties": {
          "persona": { "type": "string", "minLength": 1 },
          "story": {
            "type": "string",
            "minLength": 20,
            "description": "As a [role], I want to [action] so that [benefit]"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string", "minLength": 10 }
          }
        },
        "additionalProperties": false
      }
    },
    "core_features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["name", "description", "priority", "effort_hours"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 20, "maxLength": 500 },
          "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
          "effort_hours": { "type": "integer", "minimum": 1, "maximum": 200 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string", "minLength": 10 }
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["criterion", "definition_of_done", "verification_method"],
        "properties": {
          "criterion": { "type": "string", "minLength": 10 },
          "definition_of_done": { "type": "string", "minLength": 20, "maxLength": 300 },
          "verification_method": {
            "type": "string",
            "enum": ["automated_test", "manual_qa", "user_testing", "analytics"]
          }
        },
        "additionalProperties": false
      }
    },
    "success_metrics": {
      "type": "object",
      "required": ["north_star", "key_metrics"],
      "properties": {
        "north_star": { "type": "string", "minLength": 20, "maxLength": 200 },
        "key_metrics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["metric", "baseline", "target", "measurement_window"],
            "properties": {
              "metric": { "type": "string", "minLength": 5 },
              "baseline": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "measurement_window": { "type": "string", "enum": ["daily", "weekly", "monthly"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "constraints_and_assumptions": {
      "type": "object",
      "properties": {
        "technical_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 10 }
        },
        "business_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 10 }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        }
      },
      "additionalProperties": false
    },
    "risks_and_mitigations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["risk", "probability", "impact", "mitigation"],
        "properties": {
          "risk": { "type": "string", "minLength": 20 },
          "probability": { "type": "string", "enum": ["high", "medium", "low"] },
          "impact": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string", "minLength": 20, "maxLength": 300 }
        },
        "additionalProperties": false
      }
    },
    "competitive_positioning": {
      "type": "object",
      "required": ["unique_value_prop", "why_us_over_competitors"],
      "properties": {
        "unique_value_prop": { "type": "string", "minLength": 30, "maxLength": 300 },
        "why_us_over_competitors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 20 }
        },
        "market_window": { "type": "string", "minLength": 10, "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "monetization_model": {
      "type": "object",
      "required": ["model_type", "pricing_strategy", "target_arr"],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": ["freemium", "subscription", "pay_per_use", "one_time", "hybrid"]
        },
        "pricing_strategy": { "type": "string", "minLength": 30, "maxLength": 500 },
        "target_arr": { "type": "integer", "minimum": 0, "description": "USD" },
        "customer_acquisition_cost": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "timeline_estimate_weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52,
      "description": "MVP implementation time estimate"
    }
  }
}
