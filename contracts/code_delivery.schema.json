{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code_delivery.schema.json",
  "title": "Code Delivery Report",
  "description": "Stage 6-7 output: MVP implementation and test results",
  "type": "object",
  "required": [
    "pipeline_id",
    "tech_spec_id",
    "created_at",
    "product_title",
    "repository_url",
    "git_commit_hash",
    "implementation_summary",
    "features_completed",
    "test_coverage",
    "security_scan_results",
    "performance_metrics",
    "known_limitations",
    "deployment_checklist"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "tech_spec_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "git_commit_hash": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "description": "Short or long commit hash for traceability"
    },
    "implementation_summary": {
      "type": "string",
      "minLength": 100,
      "maxLength": 2000,
      "description": "Overview of what was built and key decisions"
    },
    "features_completed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "pr_number"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["complete", "partial", "blocked"] },
          "pr_number": { "type": "integer" },
          "test_passed": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "test_coverage": {
      "type": "object",
      "required": ["overall_percentage", "breakdown", "critical_paths_tested"],
      "properties": {
        "overall_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "unit_tests": { "type": "number", "minimum": 0 },
            "integration_tests": { "type": "number", "minimum": 0 },
            "e2e_tests": { "type": "number", "minimum": 0 },
            "total_tests": { "type": "integer", "minimum": 1 }
          }
        },
        "critical_paths_tested": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "test_framework": { "type": "string" }
      },
      "additionalProperties": false
    },
    "security_scan_results": {
      "type": "object",
      "required": ["scan_date", "tool_used", "vulnerabilities"],
      "properties": {
        "scan_date": { "type": "string", "format": "date" },
        "tool_used": { "type": "array", "items": { "type": "string" } },
        "vulnerabilities": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "remediation_plan": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "api_response_time_ms": { "type": "number", "minimum": 0 },
        "db_query_time_ms": { "type": "number", "minimum": 0 },
        "frontend_load_time_ms": { "type": "number", "minimum": 0 },
        "bundle_size_kb": { "type": "number", "minimum": 0 },
        "lighthouse_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "throughput_requests_per_second": { "type": "number", "minimum": 0 }
      }
    },
    "code_quality": {
      "type": "object",
      "properties": {
        "linting_issues": { "type": "integer", "minimum": 0 },
        "code_style_compliance": { "type": "string", "enum": ["pass", "fail", "warning"] },
        "type_checking": { "type": "string", "enum": ["strict", "moderate", "loose"] },
        "complexity_analysis": {
          "type": "object",
          "properties": {
            "cyclomatic_complexity": { "type": "number", "minimum": 0 },
            "high_complexity_functions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["limitation", "workaround", "priority"],
        "properties": {
          "limitation": { "type": "string", "minLength": 20 },
          "workaround": { "type": "string", "minLength": 10 },
          "priority": { "type": "string", "enum": ["p0", "p1", "p2"] },
          "planned_fix_version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "deployment_checklist": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["item", "completed"],
        "properties": {
          "item": { "type": "string", "minLength": 10 },
          "completed": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "deployment_plan": {
      "type": "object",
      "properties": {
        "staging_deployed_at": { "type": "string", "format": "date-time" },
        "production_target_date": { "type": "string", "format": "date" },
        "rollback_strategy": { "type": "string", "minLength": 20 },
        "monitoring_setup": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
