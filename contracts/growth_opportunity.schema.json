{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "growth_opportunity.schema.json",
  "title": "Growth Opportunity",
  "description": "G3 output: prioritized growth opportunities",
  "type": "object",
  "required": [
    "growth_id",
    "created_at",
    "product_title",
    "zhihu_opportunities",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "growth_id": {
      "type": "string",
      "pattern": "^growth_(zhihu|reddit|hn|multi)_\\d{4}-\\d{2}-\\d{2}_\\d{3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_title": {
      "type": "string",
      "minLength": 1
    },
    "zhihu_opportunities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "cluster_label",
          "demand_score",
          "top_questions"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "cluster_label": {
            "type": "string"
          },
          "demand_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "question_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_view_count": {
            "type": "integer",
            "minimum": 0
          },
          "avg_answer_count": {
            "type": "number",
            "minimum": 0
          },
          "trend": {
            "type": "string",
            "enum": ["up", "stable", "down", "unknown"]
          },
          "top_questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "question_id",
                "title",
                "url",
                "opportunity_score"
              ],
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "detail": {
                  "type": "string"
                },
                "opportunity_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Score for answering this specific question"
                },
                "signals": {
                  "type": "object",
                  "properties": {
                    "view_count": {
                      "type": "integer"
                    },
                    "follower_count": {
                      "type": "integer"
                    },
                    "answer_count": {
                      "type": "integer"
                    },
                    "freshness": {
                      "type": "string",
                      "enum": ["hot", "active", "recent", "old"]
                    },
                    "competition_level": {
                      "type": "string",
                      "enum": ["low", "medium", "high"]
                    }
                  },
                  "additionalProperties": false
                },
                "why_answer": {
                  "type": "string",
                  "description": "Rationale for answering this question"
                }
              },
              "additionalProperties": false
            },
            "description": "Top questions to answer in this cluster"
          },
          "seo_opportunities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slug", "type", "title_suggestion", "rationale"],
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^/[a-z0-9/-]+$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "landing_page",
                    "converter_tool",
                    "how_to_guide",
                    "comparison",
                    "api_docs"
                  ]
                },
                "title_suggestion": {
                  "type": "string",
                  "minLength": 10
                },
                "rationale": {
                  "type": "string",
                  "minLength": 20,
                  "description": "Why create this page"
                }
              },
              "additionalProperties": false
            },
            "description": "SEO page opportunities (Phase 2)"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_clusters",
        "total_zhihu_questions",
        "top_priority"
      ],
      "properties": {
        "total_clusters": {
          "type": "integer",
          "minimum": 0
        },
        "total_zhihu_questions": {
          "type": "integer",
          "minimum": 0,
          "description": "Total questions identified for answering"
        },
        "seo_opportunities_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_priority": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Top cluster IDs by priority"
        },
        "estimated_reach": {
          "type": "integer",
          "minimum": 0,
          "description": "Total potential view count"
        }
      },
      "additionalProperties": false
    }
  }
}
